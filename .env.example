# Copy to .env.local and fill in. Never commit .env.local.
# The app starts with none of these. Sample tables need no keys. Setup shows what each kind of call still needs.

# Claude API key from platform.claude.com
ANTHROPIC_API_KEY=

# Jev key from console.typesafe.ai
TYPESAFE_API_KEY=

# Your own phone number for test runs (Fo calls it and you play the kitchen)
FO_TEST_PHONE=

# Report fidelity starts unverified and turns verified only when the practice call in Setup passes.
# While unverified, CrossCheck never auto matches; you read and tick each quote instead.
# Leave this empty (unverified does the same). Set it to force_unverified to force that review even after
# a practice call passed. It cannot make fidelity verified.
FO_REPORT_FIDELITY=

# Optional
# JEV_MODEL=jev-1.13.0
# CLAUDE_MODEL=claude-opus-5-5
